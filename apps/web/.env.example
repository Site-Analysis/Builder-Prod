# Local development (npm run dev). Full variable reference: ../../.env.builders.example
# The server refuses to start if a required variable is missing.

# ── Environment ───────────────────────────────────────────────────────────────
# DEV_BYPASS_AUTH / NEXT_PUBLIC_DEV_BYPASS_AUTH are allowed only with APP_ENV=local
APP_ENV=local

# ── Auth (Keycloak + Auth.js) ────────────────────────────────────────────────
KEYCLOAK_URL=http://localhost:8180
KEYCLOAK_REALM=sat
KEYCLOAK_CLIENT_ID=sat-web
# confidential client secret (Clients -> Credentials); required at start-up
KEYCLOAK_CLIENT_SECRET=
AUTH_URL=http://localhost:3000
# random 32+ chars: openssl rand -hex 32
AUTH_SECRET=

# skip login entirely (only with APP_ENV=local); set both or neither
# DEV_BYPASS_AUTH=1
# NEXT_PUBLIC_DEV_BYPASS_AUTH=1

# ── Supabase (project metadata) ───────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Cadastral service (port 8011) ────────────────────────────────────────────
NEXT_PUBLIC_CADASTRAL_API_URL=http://localhost:8011
NEXT_PUBLIC_ENABLE_CADASTRAL_EXPLORER=1
