# ── Auth (Keycloak) ──────────────────────────────────────────────────────────
# Keycloak runs in docker-compose on port 8180; frontend accesses it via localhost
KEYCLOAK_URL=http://localhost:8180
KEYCLOAK_REALM=sat
KEYCLOAK_CLIENT_ID=sat-web
NEXTAUTH_URL=http://localhost:3000
AUTH_SECRET=

# ── Supabase (project metadata) ───────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Cadastral service (port 8011) ────────────────────────────────────────────
NEXT_PUBLIC_CADASTRAL_API_URL=http://localhost:8011
NEXT_PUBLIC_ENABLE_CADASTRAL_EXPLORER=1

# ── Planning service (port 8012) ─────────────────────────────────────────────
NEXT_PUBLIC_PLANNING_API_URL=http://localhost:8012
# 2031 plan layers (side panel, area picker, legend card, parcel-card section); 0/unset = off
NEXT_PUBLIC_ENABLE_PLANNING_LAYERS=1
# Draw plan zones from the pre-drawn tiles in Supabase Storage (bucket planning-tiles, public;
# needs NEXT_PUBLIC_SUPABASE_URL of the project that holds them); 0 = load zones from the service
NEXT_PUBLIC_PLANNING_PREBUILT_TILES=1
