# ── Builder Module — Runtime Environment ──────────────────────────────────────
# Copy to .env.builders and fill in values before running. Never commit the filled file.
#
# QUICK START (builder-server — full stack):
#   docker run -p 3000:3000 -p 8011:8011 --env-file .env.builders \
#     -v /path/to/data:/data:ro \
#     tanmaycj/builder-server:<git-sha>
#
# QUICK START (builder-frontend — UI only, points at external API):
#   docker run -p 3000:3000 --env-file .env.builders tanmaycj/builder-frontend:<git-sha>
#
# BUILD (tag + label with the commit, so a running container can be traced to its code):
#   SHA=$(git rev-parse --short HEAD)
#   docker build --build-arg GIT_SHA=$SHA \
#     --build-arg NEXT_PUBLIC_CADASTRAL_API_URL=https://uat.qnit.in/api \
#     --build-arg NEXT_PUBLIC_SUPABASE_URL=... --build-arg NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=... \
#     -t tanmaycj/builder-server:$SHA -t tanmaycj/builder-server:latest .
#   docker inspect -f '{{ index .Config.Labels "org.opencontainers.image.revision" }}' \
#     tanmaycj/builder-server:$SHA
#
# Who reads what:  [web] = Next.js server (port 3000)   [api] = cadastral FastAPI (8011)
#                  [build] = baked into the browser bundle at `docker build` time; setting
#                  it at `docker run` has NO effect, the image must be rebuilt.
# Both services refuse to start when a required variable is missing, and when the auth
# bypass is on outside APP_ENV=local.
# ─────────────────────────────────────────────────────────────────────────────

# ── Environment ───────────────────────────────────────────────────────────────
# [web][api] local | uat | production. DEV_BYPASS_AUTH works ONLY with APP_ENV=local.
APP_ENV=production

# ── Auth.js (NextAuth v5) ─────────────────────────────────────────────────────
# [web] required. Random 32+ chars: openssl rand -hex 32
AUTH_SECRET=
# [web] required. Public URL of the app, e.g. https://uat.qnit.in
#       (also the post-logout redirect: register it on the Keycloak client)
AUTH_URL=http://localhost:3000
# Fallbacks only, not needed when the AUTH_* names are set:
#   NEXTAUTH_URL    -> read if AUTH_URL is unset (old Auth.js v4 name)
#   NEXTAUTH_SECRET -> read if AUTH_SECRET is unset
#   AUTH_TRUST_HOST -> not needed: the app sets trustHost: true (behind Caddy / Cloudflare)

# ── Keycloak ──────────────────────────────────────────────────────────────────
# [web][api] required. PUBLIC base URL incl. any path prefix (the browser is sent here),
#            e.g. https://uat.qnit.in/auth  (a trailing / is fine)
KEYCLOAK_URL=https://uat.qnit.in/auth
# [web][api] required
KEYCLOAK_REALM=SiteAnalysisRealm
# [web][api] required. The client's NAME (Clients -> Client ID), e.g. sat-builder.
#            The API accepts only access tokens issued to this client (azp).
KEYCLOAK_CLIENT_ID=sat-builder
# [web] required. Clients -> sat-builder -> Credentials -> Client secret (confidential client)
KEYCLOAK_CLIENT_SECRET=
# [api] optional. Expected token issuer; default {KEYCLOAK_URL}/realms/{KEYCLOAK_REALM}
# KEYCLOAK_ISSUER=
# [api] optional. Fetch signing keys over the internal network instead of the public URL,
#       e.g. http://keycloak-uat:8080/auth/realms/SiteAnalysisRealm/protocol/openid-connect/certs
# KEYCLOAK_JWKS_URL=

# ── Supabase (project storage) ────────────────────────────────────────────────
# [web][build] project URL and publishable key
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# [web] required for /api/projects. Full database access: keep secret, never share
SUPABASE_SERVICE_ROLE_KEY=

# ── Cadastral backend (builder-server only) ───────────────────────────────────
# [api] dataset mount (the folder that holds dist_*); survey index on a persistent volume
CADASTRAL_DATA_DIR=/data/cadastral_lake_v2
SURVEY_INDEX_DB=/survey_index/survey_index.db
# [api] feature flags
FLAGS=feature.cadastral.land-records
# [api] JSON list (a comma-separated list is also accepted)
CORS_ORIGINS=["http://localhost:3000"]
# [api] optional. 1 = serve /docs, /redoc, /openapi.json (off by default: they list
#       every route publicly)
# ENABLE_API_DOCS=1

# ── Local development only ────────────────────────────────────────────────────
# [web][api] skip all login / token checks. Refused unless APP_ENV=local.
# DEV_BYPASS_AUTH=1
# [build] browser-side bypass; must match DEV_BYPASS_AUTH. An image built with it on
#         refuses to start unless APP_ENV=local.
# NEXT_PUBLIC_DEV_BYPASS_AUTH=1
