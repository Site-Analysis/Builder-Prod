# ── Builder Module — Runtime Environment ──────────────────────────────────────
# Copy to .env.builders and fill in values before running.
#
# QUICK START (builder-server — full stack):
#   docker pull tanmaycj/builder-server:latest
#   docker run -p 3000:3000 -p 8011:8011 --env-file .env.builders \
#     -v /path/to/data:/data:ro \
#     tanmaycj/builder-server:latest
#
# QUICK START (builder-frontend — UI only, points at external API):
#   docker pull tanmaycj/builder-frontend:latest
#   docker run -p 3000:3000 --env-file .env.builders \
#     tanmaycj/builder-frontend:latest
#
# Then open http://localhost:3000
# ─────────────────────────────────────────────────────────────────────────────

# ── NextAuth ──────────────────────────────────────────────────────────────────
# AUTH_SECRET: any random 32+ char string — run: openssl rand -hex 32
AUTH_SECRET=

# URL where the app is served (change port if you remapped)
NEXTAUTH_URL=http://localhost:3000

# ── Keycloak ──────────────────────────────────────────────────────────────────
KEYCLOAK_URL=https://architecture.qnit.site/auth
KEYCLOAK_REALM=sat
KEYCLOAK_CLIENT_ID=sat-web

# ── Supabase ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://kkuymxonuanylomjsofi.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_WSLJn2LG5DJhlDDZ6g9wmg_JYI5qe1z
# Service role key — keep secret, never expose publicly
SUPABASE_SERVICE_ROLE_KEY=

# ── Cadastral backend (builder-server only) ───────────────────────────────────
# Path inside container where the dataset is mounted
CADASTRAL_DATA_DIR=/data/cadastral_lake_v2
SURVEY_INDEX_DB=/survey_index/survey_index.db
FLAGS=feature.cadastral.land-records
CORS_ORIGINS=["http://localhost:3000"]
