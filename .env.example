# ── Cadastral data (docker-compose mounts) ───────────────────────────────────
CADASTRAL_DATA_ROOT=/path/to/dir/containing/cadastral_lake_v2
SURVEY_INDEX_PATH=./data/survey_index

# ── Keycloak (self-hosted via docker-compose) ─────────────────────────────────
KEYCLOAK_ADMIN_PASSWORD=change_me_strong_password
# KEYCLOAK_URL defaults to http://keycloak:8080 inside docker-compose.
# For the frontend (running outside Docker), point to the host-exposed port:
KEYCLOAK_URL=http://localhost:8180
KEYCLOAK_REALM=sat
KEYCLOAK_CLIENT_ID=sat-web

# ── Next.js / NextAuth ───────────────────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
AUTH_SECRET=

# ── Supabase (project metadata + auth — NOT parcel data) ────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Cadastral service ────────────────────────────────────────────────────────
NEXT_PUBLIC_CADASTRAL_API_URL=http://localhost:8011
NEXT_PUBLIC_ENABLE_CADASTRAL_EXPLORER=1

# ── Planning service ─────────────────────────────────────────────────────────
# No data root: the service reads infra/planning (register + layer_index.json) and extracts plan
# sheets on demand into %TEMP%\qnit_planning (deleted after use). Map zones are pre-drawn tiles
# in Supabase Storage (public bucket planning-tiles) read by the web app.
NEXT_PUBLIC_PLANNING_API_URL=http://localhost:8012
NEXT_PUBLIC_ENABLE_PLANNING_LAYERS=1
NEXT_PUBLIC_PLANNING_PREBUILT_TILES=1
# Plan roads (contract 1.20): the "Roads (plan ROW)" switch and the parcel card's Roads section.
# The service reads the roads from the published tile manifest of your Supabase project:
NEXT_PUBLIC_PLANNING_ROADS=1
PLANNING_ROADS_SOURCE=https://xxxx.supabase.co/storage/v1/object/public/planning-tiles/manifest.json
