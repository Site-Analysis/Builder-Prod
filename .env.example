# ── Cadastral data (docker-compose mounts) ───────────────────────────────────
CADASTRAL_DATA_ROOT=/path/to/dir/containing/cadastral_lake_v2
SURVEY_INDEX_PATH=./data/survey_index

# ── Auth (Keycloak) ──────────────────────────────────────────────────────────
KEYCLOAK_URL=https://auth.builder.qnit.site
KEYCLOAK_REALM=sat
KEYCLOAK_CLIENT_ID=sat-web

# ── Next.js / NextAuth ───────────────────────────────────────────────────────
AUTH_SECRET=

# ── Supabase (project metadata + auth — NOT parcel data) ────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Cadastral service ────────────────────────────────────────────────────────
NEXT_PUBLIC_CADASTRAL_API_URL=http://localhost:8011
NEXT_PUBLIC_ENABLE_CADASTRAL_EXPLORER=1
