# Production env for docker-compose.prod.yml
# Copy to .env and fill in values before starting.
# Never commit .env

KEYCLOAK_ADMIN_PASSWORD=<strong-random-password>

# Supabase PostgreSQL — used as Keycloak's DB backend
KC_DB_PASSWORD=<supabase-postgres-password>

# Data paths are bind-mounted in docker-compose.prod.yml:
#   /opt/builder/data/cadastral_lake_v2  → cadastral parquets
#   /opt/builder/data/lgd_villages.parquet
#   /opt/builder/db/karnataka_lands_full.db
#   /opt/builder/data/echawadi_village_list.json (parent of cadastral_lake_v2)
# No extra env vars needed — paths are hardcoded in the compose file.
